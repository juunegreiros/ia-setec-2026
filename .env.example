# Copie para .env (o `make setup` faz isso sozinho na primeira vez).
# Django e Next.js leem este mesmo arquivo, na raiz do repositório.

# --- API (Django) ---
DJANGO_SECRET_KEY=django-insecure-dev-only-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Usuário do Django Admin criado pelo `make setup` (só para uso local).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
